generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DONOR
  RECEIVER
  HOSPITAL
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ADMITTED
  UNDER_TREATMENT
  DISCHARGED
}

enum Urgency {
  NORMAL
  URGENT
  CRITICAL
}

enum RequestStatus {
  PENDING
  APPROVED
  MATCHED
  COMPLETED
  REJECTED
  CANCELLED
}

enum AlertStatus {
  NOTIFIED
  ACCEPTED
  REJECTED
}

enum DonationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  DECLINED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
}

enum NotificationType {
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  BLOOD_REQUEST_ALERT
  DONOR_ACCEPTED
  HOSPITAL_APPROVED
  REQUEST_COMPLETED
  GENERAL
}

// ---------- Users ----------
model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(PENDING)
  name         String
  phone        String
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  admin         Admin?
  donor         Donor?
  receiver      Receiver?
  hospital      Hospital?
  notifications Notification[]
  logs          SystemLog[]
  feedback      Feedback[]
  chatMessages  ChatMessage[]
  resets        PasswordReset[]
  reports       Report[]

  @@index([role, status])
  @@index([name])
  @@map("users")
}

model Admin {
  id          Int    @id @default(autoincrement())
  userId      Int    @unique
  designation String @default("System Administrator")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Donor {
  id               Int        @id @default(autoincrement())
  userId           Int        @unique
  bloodGroup       BloodGroup
  address          String
  city             String
  latitude         Float?
  longitude        Float?
  availability     Boolean    @default(true)
  weightKg         Float?
  medicalInfo      String?
  lastDonationDate DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts    RequestAlert[]
  donations Donation[]

  @@index([bloodGroup, availability])
  @@index([city])
  @@map("donors")
}

model Receiver {
  id         Int        @id @default(autoincrement())
  userId     Int        @unique
  bloodGroup BloodGroup
  address    String
  city       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests BloodRequest[]

  @@map("receivers")
}

model Hospital {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  licenseNo String   @unique
  address   String
  city      String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patients  Patient[]
  requests  BloodRequest[]
  donations Donation[]
  inventory BloodInventory[]

  @@index([city])
  @@map("hospitals")
}

model Patient {
  id            Int           @id @default(autoincrement())
  hospitalId    Int
  name          String
  age           Int
  gender        Gender
  bloodGroup    BloodGroup
  diagnosis     String
  admissionDate DateTime
  status        PatientStatus @default(ADMITTED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@map("patients")
}

// ---------- Inventory ----------
model BloodInventory {
  id             Int             @id @default(autoincrement())
  bloodGroup     BloodGroup
  units          Int
  amountMl       Int
  status         InventoryStatus @default(AVAILABLE)
  collectionDate DateTime
  expiryDate     DateTime
  hospitalId     Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([bloodGroup, expiryDate])
  @@map("blood_inventory")
}

// ---------- Requests ----------
model BloodRequest {
  id               Int           @id @default(autoincrement())
  receiverId       Int
  hospitalId       Int?
  patientName      String
  bloodGroup       BloodGroup
  units            Int
  urgency          Urgency       @default(NORMAL)
  status           RequestStatus @default(PENDING)
  requiredDate     DateTime
  city             String
  address          String?
  latitude         Float?
  longitude        Float?
  notes            String?
  hospitalApproved Boolean       @default(false)
  approvedAt       DateTime?
  completedAt      DateTime?
  searchRadiusKm   Int           @default(0)
  lastExpandedAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  receiver Receiver       @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  hospital Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  alerts   RequestAlert[]
  donations Donation[]
  messages ChatMessage[]
  feedback Feedback[]

  @@index([status, urgency])
  @@index([bloodGroup])
  @@index([receiverId])
  @@index([hospitalId])
  @@map("blood_requests")
}

model RequestAlert {
  id         Int         @id @default(autoincrement())
  requestId  Int
  donorId    Int
  distanceKm Float?
  status     AlertStatus @default(NOTIFIED)
  wave       Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId])
  @@index([donorId, status])
  @@map("request_alerts")
}

model Donation {
  id           Int            @id @default(autoincrement())
  donorId      Int
  requestId    Int?
  hospitalId   Int?
  units        Int            @default(1)
  status       DonationStatus @default(PENDING)
  donationDate DateTime       @default(now())
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  donor    Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  request  BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  hospital Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([requestId])
  @@index([status])
  @@map("donations")
}

// ---------- Engagement ----------
model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  requestId Int?
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  request BloodRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([rating])
  @@map("feedback")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  requestId Int
  senderId  Int
  message   String
  createdAt DateTime @default(now())

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("chat_messages")
}

model Report {
  id          Int      @id @default(autoincrement())
  type        String
  generatedBy Int?
  summary     Json
  createdAt   DateTime @default(now())

  admin User? @relation(fields: [generatedBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@map("system_logs")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}
