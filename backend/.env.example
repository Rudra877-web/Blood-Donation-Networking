# --- Required ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/blood_donation?schema=public"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Email (optional; if empty, emails are logged to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Blood Donation Network <no-reply@example.com>"

# --- Business rules (optional, defaults shown) ---
MIN_DONATION_GAP_DAYS=90
MIN_DONOR_WEIGHT_KG=45
MATCH_BATCH_SIZE=5
SEARCH_RADIUS_STEPS_KM=10,25,50,100,250
AUTO_EXPAND_AFTER_MINUTES=15
LOW_STOCK_UNITS=5
